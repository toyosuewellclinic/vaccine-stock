# ---- Slack ----
# https://api.slack.com/apps で作成したアプリの値を設定
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# 確定シフトを投稿するチャンネル（例: C0123456789 / #shift でも可）
SLACK_SHIFT_CHANNEL=C0123456789
# 交代・欠勤申請の承認依頼を流すチャンネル（未設定なら SLACK_SHIFT_CHANNEL を使用）
SLACK_ADMIN_CHANNEL=

# ---- Supabase ----
# 既存プロジェクトをそのまま利用。service_role キーはサーバー専用（絶対に公開しない）
SUPABASE_URL=https://jgnlzogfnqawtfcvzpzx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# ---- 管理Web UI ----
# /admin の API 認証に使うトークン。長いランダム文字列を設定する
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- 動作設定 ----
PORT=3000
TZ_NAME=Asia/Tokyo
# 勤務間インターバル（時間）
MIN_REST_HOURS=11
# 連勤上限のデフォルト（スタッフ個別設定が優先）
DEFAULT_MAX_CONSECUTIVE_DAYS=5
# リマインドの実行時刻（cron形式 / TZ_NAME のタイムゾーンで評価）
CRON_DEADLINE_REMINDER=0 9 * * *
CRON_TOMORROW_REMINDER=0 18 * * *
# false にすると cron を起動しない（ローカル開発用）
ENABLE_CRON=true
